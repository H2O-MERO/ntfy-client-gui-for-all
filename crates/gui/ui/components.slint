import { LineEdit, Palette } from "std-widgets.slint";

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 42px;
    vertical-stretch: 0;
    border-radius: 8px;
    background: selected ? Palette.accent-background : touch.has-hover ? Palette.control-background : transparent;
    animate background { duration: 100ms; }
    Text {
        text: root.label;
        color: selected ? Palette.accent-foreground : Palette.foreground;
        font-size: 15px;
        font-weight: selected ? 600 : 400;
        vertical-alignment: center;
        x: 14px;
        width: parent.width - 28px;
        overflow: elide;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component SectionCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
    vertical-stretch: 0;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;
        Text { height: 24px; vertical-stretch: 0; text: root.title; color: Palette.foreground; font-size: 17px; font-weight: 600; vertical-alignment: center; }
        Text { height: 34px; vertical-stretch: 0; text: root.subtitle; color: Palette.foreground.with-alpha(0.65); font-size: 12px; wrap: word-wrap; vertical-alignment: top; }
        @children
    }
}

export component StatCard inherits Rectangle {
    in property <string> value;
    in property <string> label;
    border-radius: 12px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    height: 126px;
    min-width: 150px;
    vertical-stretch: 0;
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        Text { height: 42px; vertical-stretch: 0; text: root.value; color: Palette.accent-background; font-size: 27px; font-weight: 700; overflow: elide; vertical-alignment: center; }
        Text { height: 24px; vertical-stretch: 0; text: root.label; color: Palette.foreground.with-alpha(0.7); font-size: 13px; vertical-alignment: center; }
    }
}

export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value <=> input.text;
    in property <bool> password: false;
    height: 66px;
    vertical-stretch: 0;
    spacing: 5px;
    alignment: start;
    Text { height: 20px; vertical-stretch: 0; text: root.label; color: Palette.foreground.with-alpha(0.75); font-size: 12px; vertical-alignment: center; }
    input := LineEdit {
        height: 40px;
        vertical-stretch: 0;
        placeholder-text: root.placeholder;
        input-type: root.password ? InputType.password : InputType.text;
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    height: 76px;
    vertical-stretch: 0;
    spacing: 6px;
    alignment: start;
    Text {
        height: 42px;
        vertical-stretch: 0;
        text: root.title;
        color: Palette.foreground;
        font-size: 30px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        height: 24px;
        vertical-stretch: 0;
        text: root.subtitle;
        color: Palette.foreground.with-alpha(0.65);
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
}
